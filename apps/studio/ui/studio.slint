import { ScrollView } from "std-widgets.slint";

export struct TimelineClipItem {
    name: string, source-path: string, start-ratio: float, width-ratio: float, row: int, audio: bool,
    waveform-start-ratio: float, waveform-width-ratio: float, waveform: [float],
}
export struct TimelineMarkerItem { label: string, ratio: float, timecode: string }
export struct ShortcutItem { keys: string, name: string, detail: string, available: bool }
export struct CommandItem { id: string, label: string, detail: string, shortcut: string, enabled: bool }
export global ContextHelp { in-out property <string> text; }
export struct TimelineTransitionItem { ratio: float, width-ratio: float, row: int }
export struct MediaCard { index: int, name: string, frame: image, has-frame: bool, status: string, offline: bool, file-size: string, uses: int }
export struct HistoryItem { label: string, applied: bool }
export struct TrackItem { name: string, audio: bool, locked: bool, muted: bool, visible: bool }
export struct LumaScopeColumn { low: float, high: float }

component ScopePlot inherits Rectangle {
    in property <int> mode;
    in property <[float]> histogram;
    in property <[LumaScopeColumn]> waveform;
    in property <[float]> chroma;
    background: #101319;
    clip: true;
                                                    if root.mode == 0 : Rectangle { background: transparent;
                                                        for value[index] in root.histogram : Rectangle {
                                                            x: index * parent.width / root.histogram.length;
                                                            y: parent.height - self.height;
                                                            width: Math.max(1px, parent.width / root.histogram.length - 1px);
                                                            height: Math.max(1px, value * parent.height);
                                                            background: index < 2 || index >= root.histogram.length - 2 ? #d98989cc : #9ac8b5cc;
                                                        }
                                                    }
                                                    if root.mode == 1 : Rectangle { background: transparent;
                                                        for column[index] in root.waveform : Rectangle {
                                                            x: index * parent.width / root.waveform.length;
                                                            y: parent.height * (1 - column.high);
                                                            width: Math.max(1px, parent.width / root.waveform.length);
                                                            height: Math.max(1px, parent.height * (column.high - column.low));
                                                            background: #9ac8b5aa;
                                                        }
                                                    }
                                                    if root.mode == 2 : Rectangle { background: transparent;
                                                        for density[index] in root.chroma : Rectangle {
                                                            x: Math.mod(index, 16) * parent.width / 16;
                                                            y: Math.floor(index / 16) * parent.height / 16;
                                                            width: Math.max(1px, parent.width / 16);
                                                            height: Math.max(1px, parent.height / 16);
                                                            background: #78d7c4;
                                                            opacity: density;
                                                        }
                                                        Rectangle { x: parent.width / 2; width: 1px; height: parent.height; background: #8b91a044; }
                                                        Rectangle { y: parent.height / 2; width: parent.width; height: 1px; background: #8b91a044; }
                                                    }
                                                    if root.mode == 1 : Rectangle { y: parent.height * (1 - 235 / 255); width: parent.width; height: 1px; background: #d9898955; }
                                                    if root.mode == 1 : Rectangle { y: parent.height * (1 - 16 / 255); width: parent.width; height: 1px; background: #d9898955; }
}

component SourceRangeBar inherits Rectangle {
    in property <float> position;
    in property <float> range-in;
    in property <float> range-out;
    in property <bool> available;
    callback seek(float);
    height: 14px;
    background: #24222c;
    Rectangle { y: 4px; width: parent.width; height: 6px; background: #393340; }
    Rectangle { x: parent.width * root.range-in; y: 4px; width: parent.width * Math.max(0, root.range-out - root.range-in); height: 6px; background: root.available ? #786797 : #393340; }
    Rectangle { x: Math.min(parent.width - 2px, parent.width * root.range-in); y: 2px; width: 2px; height: 10px; background: root.available ? #b9a3d6 : transparent; }
    Rectangle { x: Math.max(0px, parent.width * root.range-out - 2px); y: 2px; width: 2px; height: 10px; background: root.available ? #b9a3d6 : transparent; }
    Rectangle { x: Math.max(0px, Math.min(parent.width - 2px, parent.width * root.position)); width: 2px; height: parent.height; background: root.available ? #e4daff : transparent; }
    TouchArea { enabled: root.available; clicked => { root.seek(Math.max(0, Math.min(1, self.mouse-x / self.width))); } moved => { if self.pressed { root.seek(Math.max(0, Math.min(1, self.mouse-x / self.width))); } } }
}

component Action inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> icon-only: false;
    in property <bool> with-icon: false;
    in property <bool> trailing-icon: false;
    in property <string> hint: "";
    in property <bool> quiet: false;
    in property <bool> primary: false;
    in property <bool> enabled: true;
    in property <bool> active: false;
    callback clicked();
    height: 32px; min-width: root.with-icon ? 64px : 32px; border-radius: 4px;
    background: !enabled ? #26262c : primary ? (hit.has-hover ? #a59bff : #9285f5) : active ? #383343 : hit.has-hover ? #35353d : root.quiet ? transparent : #29292f;
    border-width: 1px; border-color: active ? #9285f5 : primary ? #a89cff : root.quiet ? transparent : #3b3b43;
    Image { visible: root.icon-only || root.with-icon; source: root.icon; x: root.icon-only ? (parent.width - 18px) / 2 : root.trailing-icon ? parent.width - 26px : 8px; y: (parent.height - 18px) / 2; width: 18px; height: 18px; image-fit: contain; colorize: !root.enabled ? #656570 : root.primary ? #17141f : root.active ? #c6bdff : #d8d8e0; }
    Text { visible: !root.icon-only; x: root.with-icon ? (root.trailing-icon ? 8px : 32px) : 0px; width: parent.width - (root.with-icon ? 40px : 0px); overflow: elide; text: root.label; color: !root.enabled ? #656570 : root.primary ? #17141f : root.active ? #c6bdff : #d8d8e0; font-size: 12px; font-weight: root.primary ? 600 : 400; horizontal-alignment: root.with-icon ? left : center; vertical-alignment: center; }
    hit := TouchArea { changed has-hover => { ContextHelp.text = self.has-hover ? root.hint : ""; } enabled: root.enabled; clicked => { button-focus.focus(); root.clicked(); } }
    forward-focus: button-focus;
    button-focus := FocusScope { x: 0px; y: 0px; width: 0px; height: 0px; enabled: root.enabled;
        key-pressed(event) => { if event.text == Key.Space || event.text == Key.Return { root.clicked(); return accept; } return reject; }
    }
    Rectangle { x: 2px; y: 2px; width: parent.width - 4px; height: parent.height - 4px; border-radius: 3px; border-width: button-focus.has-focus ? 1px : 0px; border-color: #e1d9ff; background: transparent; }
    accessible-role: button; accessible-label: root.hint == "" ? root.label : root.hint;
}
component Field inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder-text;
    in property <bool> search-field: false;
    in property <bool> enabled: true;
    callback edited();
    callback accepted();
    callback navigate(int);
    forward-focus: input;
    height: 32px; background: #19191f; border-radius: 4px; border-width: 1px;
    border-color: input.has-focus ? #a397ff : #41414c;
    Text { x: root.search-field ? 28px : 10px; y: 0px; width: parent.width - (root.search-field ? 38px : 20px); height: parent.height; overflow: elide; visible: root.text == ""; text: root.placeholder-text; color: #777785; font-size: 12px; vertical-alignment: center; }
    Image { visible: root.search-field; x: 8px; y: (parent.height - 14px) / 2; width: 14px; height: 14px; source: @image-url("../../../assets/icons/search.svg"); colorize: #96929f; }
    input := TextInput { x: root.search-field ? 28px : 10px; y: 0px; width: parent.width - (root.search-field ? 38px : 20px); height: parent.height; text <=> root.text; color: root.enabled ? #d8d8e2 : #72727e; font-size: 12px; single-line: true; enabled: root.enabled; vertical-alignment: center; selection-background-color: #66568f; selection-foreground-color: #ffffff; edited => { root.edited(); } accepted => { root.accepted(); } key-pressed(event) => { if event.text == Key.UpArrow { root.navigate(-1); return accept; } if event.text == Key.DownArrow { root.navigate(1); return accept; } return reject; } }
}

component PanelBar inherits Rectangle {
    in property <string> title; in property <string> detail: "";
    height: 34px; background: #242429;
    Rectangle { x: 0px; y: parent.height - 1px; width: parent.width; height: 1px; background: #37373e; }
    Text { x: 14px; text: root.title; color: #d9d9e1; font-size: 12px; font-weight: 600; vertical-alignment: center; }
    Text { x: parent.width - self.width - 14px; text: root.detail; color: #8c8c99; font-size: 10px; vertical-alignment: center; }
}
component EmptyState inherits Rectangle {
    in property <string> heading; in property <string> detail;
    background: #1c1c21;
    VerticalLayout { alignment: center; spacing: 12px; padding: 24px;
        Rectangle { height: 32px; background: transparent; Image { x: (parent.width - 32px) / 2; width: 32px; height: 32px; source: @image-url("../../../assets/icons/file.svg"); colorize: #9285f5; } }
        Text { text: root.heading; color: #d2d2dc; font-size: 14px; horizontal-alignment: center; }
        Text { text: root.detail; color: #858592; font-size: 11px; wrap: word-wrap; horizontal-alignment: center; }
    }
}

component WaveformStrip inherits Rectangle {
    in property <[float]> peaks;
    height: 54px; background: #171c1b; border-width: 1px; border-color: #35574f; border-radius: 3px;
    Rectangle { y: parent.height / 2; width: parent.width; height: 1px; background: #41675d; }
    for peak[index] in root.peaks : Rectangle {
        x: index * root.width / root.peaks.length;
        width: Math.max(1px, root.width / root.peaks.length - 1px);
        height: Math.max(1px, peak * (root.height - 8px));
        y: (root.height - self.height) / 2;
        background: #69aa98;
    }
    if root.peaks.length == 0 : Text { text: "Preparing waveform…"; color: #71857f; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; }
}

export component PrismStudio inherits Window {
    icon: @image-url("../../../assets/brand/prism-icon.svg");
    title: "Prism Studio — Edit with perspective"; preferred-width: 1440px; preferred-height: 900px; min-width: 1100px; min-height: 720px; background: #17171b; default-font-family: "Helvetica Neue"; default-font-size: 12px;
    in-out property <bool> palette-open: false;
    in-out property <string> palette-query: "";
    in-out property <int> palette-index: 0;
    in property <[CommandItem]> command-items;
    callback palette-filter();
    callback palette-run(string);
    in-out property <string> inspector-section: "Clip";
    in-out property <bool> precision-open: false;
    in-out property <bool> media-tools-open: false;
    in property <bool> selected-is-audio: false;
    in property <[float]> selected-waveform;
    in property <string> selected-source-path: "";
    in-out property <string> marker-label: "";
    in-out property <int> export-preset-index: 0;
    in property <bool> can-export: false;
    in property <string> export-video-summary: "No video sequence";
    in property <string> export-audio-summary: "No audio track";
    in property <string> export-preflight: "Import footage to prepare an export.";
    in-out property <string> active-workspace: "HOME";
    in-out property <string> selected-media: "";
    in-out property <int> selected-media-index: -1;
    in-out property <int> selected-clip-index: -1;
    in property <int> selected-companion-index: -1;
    in property <int> selected-track-index: -1;
    in-out property <string> search: "";
    in-out property <int> media-sort: 0;
    in-out property <int> media-filter: 0;
    in property <int> selected-media-uses: 0;
    in property <string> workspace-status: "Not saved";
    in property <string> source-preview-size: "";
    in property <string> source-file-status: "";
    in property <image> program-frame;
    in property <bool> has-program-frame: false;
    in property <[float]> program-luma-scope;
    in property <[LumaScopeColumn]> program-luma-waveform;
    in property <[float]> program-vectorscope;
    in-out property <int> program-scope-mode: 0;
    in-out property <bool> show-monitor-scope: false;
    in property <image> source-frame;
    in property <bool> has-source-frame: false;
    in property <string> source-detail: "Select footage in the media browser";
    in property <string> preview-status: "No sequence loaded";
    in-out property <float> playhead-ratio: 0;
    in-out property <bool> playing: false;
    in property <bool> playback-buffering: false;
    in property <string> timecode: "00:00:00:00";
    in property <string> duration-label: "00:00:00:00";
    in property <[string]> ruler-labels;
    in property <[TimelineMarkerItem]> timeline-markers;
    in-out property <int> selected-marker-index: -1;
    in property <[TimelineTransitionItem]> timeline-transitions;
    in-out property <string> export-status: "READY";
    in-out property <string> export-output: "Untitled Export.mp4";
    in-out property <string> export-error: "";
    in-out property <int> export-progress: -1;
    in-out property <bool> export-can-cancel: false;
    in-out property <bool> export-can-retry: false;
    in-out property <bool> export-can-remove: false;
    in-out property <bool> has-project: false;
    in-out property <string> project-name: "Untitled";
    in-out property <string> project-path: "";
    in-out property <string> project-summary: "Ready when you are";
    in-out property <string> feedback: "";
    in-out property <int> media-count: 0;
    in-out property <int> clip-count: 0;
    in property <[string]> media-items;
    in property <[MediaCard]> media-cards;
    callback filter-changed();
    in property <[TimelineClipItem]> timeline-clips;
    in property <[TrackItem]> tracks;
    in-out property <length> monitor-height: 330px;
    in-out property <bool> compact-mode: false;
    changed width => { root.compact-mode = self.width < 1250px; }
    in-out property <string> layout-preset: "Editing";
    in-out property <string> browser-tab: "Media";
    in-out property <string> inspector-tab: "Properties";
    in-out property <string> keyboard-preset: "Premiere";
    in-out property <string> shortcut-query: "";
    in property <[ShortcutItem]> shortcut-items;
    callback shortcuts-changed();
    callback edit-shortcut(string, bool, bool, bool) -> bool;
    changed keyboard-preset => { root.shortcuts-changed(); }
    in-out property <bool> inspector-open: true;
    in-out property <bool> show-safe-guides: false;
    in-out property <string> active-tool: "V";
    in-out property <bool> snap-enabled: true;
    in-out property <float> timeline-zoom: 1;
    in-out property <float> timeline-offset: 0;
    in property <bool> can-undo: false;
    in property <bool> can-redo: false;
    in property <[HistoryItem]> history-items;
    in property <string> sequence-name: "Main sequence";
    in property <string> inspector-name: "";
    in property <string> inspector-track: "";
    in property <string> inspector-path: "";
    in property <string> selected-proxy: "";
    in property <string> proxy-status: "MISSING";
    in property <int> recovery-count: 0;
    in property <string> recovery-revision: "";
    in property <string> recovery-path: "";
    in property <string> autosave-status: "UNAVAILABLE";
    in property <bool> autosave-enabled: false;
    in property <int> autosave-retention: 5;
    in property <string> media-task-status: "IDLE";
    in property <string> media-task-detail: "0/0 previews";
    in property <int> media-task-pending: 0;
    in property <string> cache-status: "UNAVAILABLE";
    in property <string> cache-detail: "Save the project to enable its derived cache";
    in property <bool> cache-cleaning: false;
    in property <string> codec-status: "UNCHECKED";
    in property <string> codec-detail: "Media runtime has not been checked";
    in-out property <bool> proxy-active: false;
    in-out property <bool> proxy-generating: false;
    in property <bool> inspector-locked: false;
    in property <bool> selected-has-next: false;
    in property <bool> selected-has-transition: false;
    in-out property <string> clip-start: "0";
    in-out property <string> paired-start: "0";
    in-out property <string> paired-source-in: "0";
    in-out property <string> paired-duration: "0";
    in-out property <string> clip-source-in: "0";
    in-out property <string> clip-duration: "0";
    in property <string> source-timecode: "00:00:00:00";
    in property <string> source-duration-label: "00:00:00:00";
    in property <string> source-in-label: "—";
    in property <string> source-out-label: "—";
    in property <float> source-ratio: 0;
    in property <float> source-in-ratio: 0;
    in property <float> source-out-ratio: 0;
    in property <string> source-range-label: "—";
    in property <bool> source-ready: false;
    in property <bool> can-edit-av: false;
    in property <string> aligned-av-detail: "Select a timeline clip";
    in-out property <bool> paired-tools-open: false;
    callback source-seek(float);
    callback view-changed();
    callback command-invoked(string);
    pure callback media-matches(string, string) -> bool;
    callback media-selected(int);
    callback clip-selected(int);
    callback clip-adjusted(int, float, string);
    callback seek(float);
    callback track-action(int, string);

    forward-focus: keyboard;
    keyboard := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape { root.palette-open = false; return accept; }
            if (event.modifiers.control || event.modifiers.meta) && event.modifiers.shift && event.text.to-lowercase() == "p" {
                root.palette-open = !root.palette-open; root.palette-query = ""; root.palette-filter(); palette-search.focus(); return accept;
            }
            if root.palette-open { return reject; }
            if root.active-workspace == "EDIT" {
                let key = event.text == Key.Space ? "Space" : event.text == Key.LeftArrow ? "Left" : event.text == Key.RightArrow ? "Right" : event.text == Key.UpArrow ? "Up" : event.text == Key.DownArrow ? "Down" : event.text == Key.Home ? "Home" : event.text == Key.End ? "End" : event.text == Key.Delete ? "Delete" : event.text == Key.Backspace ? "Backspace" : event.text;
                if root.edit-shortcut(key, event.modifiers.control || event.modifiers.meta, event.modifiers.shift, event.modifiers.alt) { return accept; }
            }
            if event.modifiers.control || event.modifiers.meta {
                if event.text.to-lowercase() == "z" { root.command-invoked(event.modifiers.shift ? "edit.redo" : "edit.undo"); return accept; }
                if event.text.to-lowercase() == "s" { root.command-invoked(event.modifiers.shift ? "project.save_as" : "project.save"); return accept; }
                if event.text.to-lowercase() == "o" { root.command-invoked("project.open"); return accept; }
                if event.text.to-lowercase() == "i" { root.command-invoked("project.import_media"); return accept; }
                if event.text.to-lowercase() == "k" && root.active-workspace == "EDIT" { root.command-invoked("timeline.split"); return accept; }
                return reject;
            }
            return reject;
        }
    VerticalLayout { spacing: 0px;
        Rectangle { height: 54px; background: #222227;
            HorizontalLayout { padding-left: 22px; padding-right: 20px; spacing: 18px; padding-top: 11px; padding-bottom: 11px;
                Image { width: 36px; height: 32px; source: @image-url("../../../assets/brand/prism-icon.svg"); image-fit: contain; }
                if !root.compact-mode : Text { text: "prism"; color: #f1f0f7; font-size: 20px; font-weight: 600; vertical-alignment: center; }
                if !root.compact-mode : Rectangle { width: 1px; height: 22px; background: #42424b; }
                for workspace in ["HOME", "IMPORT", "EDIT", "EXPORT"] : Rectangle {
                    width: root.compact-mode ? 58px : 66px; height: 32px;
                    Image { visible: workspace == "HOME"; width: 20px; height: 20px; x: (parent.width - 20px) / 2; y: 5px; source: @image-url("../../../assets/icons/home.svg"); colorize: root.active-workspace == workspace ? #ded8ff : #92929f; }
                    Text { visible: workspace != "HOME"; text: workspace; color: root.active-workspace == workspace ? #ded8ff : #92929f; font-size: 11px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                    Rectangle { x: 8px; y: parent.height - 3px; width: parent.width - 16px; height: 2px; background: root.active-workspace == workspace ? #a397ff : transparent; }
                    forward-focus: tab-focus;
                    tab-focus := FocusScope { x: 0px; y: 0px; width: 0px; height: 0px;
                        key-pressed(event) => { if event.text == Key.Space || event.text == Key.Return { root.active-workspace = workspace; return accept; } return reject; }
                    }
                    TouchArea { clicked => { tab-focus.focus(); root.active-workspace = workspace; } }
                    accessible-role: tab; accessible-label: workspace;
                }
                Rectangle { horizontal-stretch: 1; }
                if !root.compact-mode : Text { text: root.has-project ? root.project-name : "YOUR NEXT STORY STARTS HERE"; color: #9696a3; font-size: 11px; vertical-alignment: center; overflow: elide; }
                if !root.compact-mode : Action { width: 94px; label: "Commands"; hint: "Find an action · Ctrl / Cmd Shift P"; quiet: true; clicked => { root.palette-open = true; root.palette-query = ""; root.palette-filter(); palette-search.focus(); } }
                Action { width: 76px; with-icon: true; icon: @image-url("../../../assets/icons/folder-open.svg"); label: "Open"; quiet: true; clicked => { root.command-invoked("project.open"); } }
                Action { width: 80px; with-icon: true; icon: @image-url("../../../assets/icons/save.svg"); label: "Save"; enabled: root.has-project; clicked => { root.command-invoked("project.save"); } }
                if !root.compact-mode : Action { width: 96px; with-icon: true; icon: @image-url("../../../assets/icons/save-as.svg"); label: "Save as…"; enabled: root.has-project; clicked => { root.command-invoked("project.save_as"); } }
            }
        }
        if root.active-workspace == "HOME" : Rectangle {
            background: #1b1b20;
            HorizontalLayout { spacing: 0px;
                Rectangle { width: 232px; background: #202025;
                    VerticalLayout { padding: 24px; spacing: 12px;
                        Text { text: "YOUR WORKSPACE"; color: #777784; font-size: 10px; height: 30px; }
                        Action { with-icon: true; icon: @image-url("../../../assets/icons/new-project.svg"); label: "New project"; primary: true; clicked => { root.command-invoked("project.new"); } }
                        Action { with-icon: true; icon: @image-url("../../../assets/icons/folder-open.svg"); label: "Open project…"; clicked => { root.command-invoked("project.open"); } }
                        Rectangle { height: 26px; }
                        Rectangle { height: 32px; background: transparent; Image { x: 0px; y: 7px; width: 18px; height: 18px; source: @image-url("../../../assets/icons/home.svg"); colorize: #c6bdff; } Text { x: 28px; width: parent.width - 28px; height: parent.height; text: "Home"; color: #c6bdff; font-size: 13px; vertical-alignment: center; } }
                        Rectangle { vertical-stretch: 1; }
                        Text { text: "PRISM STUDIO\nA new perspective on your story."; color: #777784; font-size: 11px; wrap: word-wrap; }
                    }
                }
                Rectangle { horizontal-stretch: 1;
                    VerticalLayout { padding: 40px; spacing: 16px;
                        Text { text: "PRISM STUDIO / YOUR WORKSPACE"; color: #a397ff; font-size: 10px; font-weight: 600; height: 18px; }
                        Text { text: "Your next perspective."; color: #eeeef4; font-size: 38px; font-weight: 500; height: 64px; }
                        Text { text: "Bring your footage together in a focused editing workspace."; color: #9393a1; font-size: 14px; height: 24px; }
                        HorizontalLayout { alignment: start; spacing: 12px; Action { width: 166px; height: 40px; with-icon: true; icon: @image-url("../../../assets/icons/import.svg"); label: "Import your footage"; primary: true; clicked => { root.active-workspace = "IMPORT"; } } Action { width: 136px; height: 40px; with-icon: true; icon: @image-url("../../../assets/icons/folder-open.svg"); label: "Open a project"; clicked => { root.command-invoked("project.open"); } } }
                        Rectangle { height: 24px; }
                        PanelBar { title: "Current project"; detail: root.has-project ? "SAVED LOCALLY" : "GET STARTED"; }
                        Rectangle { height: 94px; background: #25252c; border-radius: 5px;
                            Text { x: 22px; y: 20px; text: root.has-project ? root.project-name : "Your canvas is ready"; color: #e1e1eb; font-size: 16px; }
                            Text { x: 22px; y: 52px; width: parent.width - 180px; text: root.has-project ? root.project-path : "Create a project or open an existing .prism file."; color: #8e8e9b; font-size: 11px; overflow: elide; }
                            Action { visible: root.has-project; x: parent.width - 128px; y: 30px; width: 106px; with-icon: true; icon: @image-url("../../../assets/icons/arrow-right.svg"); trailing-icon: true; label: "Continue"; clicked => { root.active-workspace = "EDIT"; } }
                        }
                        if root.recovery-count > 0 : Rectangle { height: 82px; background: #302a22; border-radius: 5px; border-width: 1px; border-color: #665238;
                            Text { x: 18px; y: 13px; text: "RECOVERY AVAILABLE  /  REVISION " + root.recovery-revision; color: #d6ae68; font-size: 9px; }
                            Text { x: 18px; y: 38px; width: parent.width - 190px; text: root.recovery-path; color: #a89b88; font-size: 10px; overflow: elide; }
                            Action { x: parent.width - 156px; y: 24px; width: 138px; label: "Recover as…"; clicked => { root.command-invoked("recovery.recover_latest"); } }
                        }
                        Rectangle { vertical-stretch: 1; }
                        Text { text: "01  IMPORT       /       02  SHAPE YOUR STORY       /       03  EXPORT"; color: #6e6e7d; font-size: 10px; height: 20px; }
                    }
                }
            }
        }
        if root.active-workspace == "IMPORT" : Rectangle {
            HorizontalLayout { spacing: 1px;
                Rectangle { width: 215px; background: #202025;
                    VerticalLayout { padding: 22px; spacing: 18px;
                        Text { text: "MEDIA LIBRARY"; color: #81818f; font-size: 10px; height: 24px; }
                        Action { with-icon: true; icon: @image-url("../../../assets/icons/folder-open.svg"); label: "Browse files…"; primary: true; clicked => { root.command-invoked("project.import_media"); } }
                        Text { text: "▦   Project media"; color: #c6bdff; font-size: 12px; height: 28px; }
                        Text { text: root.media-count + " imported files"; color: #858592; font-size: 11px; height: 22px; }
                        Rectangle { vertical-stretch: 1; }
                        Text { text: "Your original files stay in place. Prism saves references to your footage."; color: #858592; font-size: 11px; wrap: word-wrap; }
                    }
                }
                Rectangle { horizontal-stretch: 1; background: #1c1c21;
                    VerticalLayout { padding: 24px; spacing: 18px;
                        HorizontalLayout { height: 34px; spacing: 12px; Text { text: "Project / Footage"; color: #e2e2eb; font-size: 16px; vertical-alignment: center; } Rectangle { horizontal-stretch: 1; } Action { width: 100px; label: root.media-sort == 0 ? "Project order" : root.media-sort == 1 ? "Name A–Z" : "Name Z–A"; quiet: true; clicked => { root.media-sort = Math.mod(root.media-sort + 1, 3); root.filter-changed(); } } Action { width: 100px; label: root.media-filter == 0 ? "All media" : root.media-filter == 1 ? "In sequence" : root.media-filter == 2 ? "Unused" : "Offline"; quiet: true; clicked => { root.media-filter = Math.mod(root.media-filter + 1, 4); root.filter-changed(); } } Field { width: 190px; search-field: true; placeholder-text: "Filter imported media"; text <=> root.search; edited => { root.filter-changed(); } } }
                        if root.media-count == 0 : EmptyState { heading: "Every story starts with a frame"; detail: "Browse your computer to import video or audio. Your media will appear here and be added to the sequence."; }
                        if root.media-count > 0 : ScrollView {
                            Rectangle { property <int> columns: Math.max(2, Math.floor(self.width / 230px));
                                min-height: Math.max(200px, Math.ceil(root.media-cards.length / self.columns) * 190px);
                                for item[index] in root.media-cards : Rectangle {
                                    x: Math.mod(index, parent.columns) * parent.width / parent.columns;
                                    y: Math.floor(index / parent.columns) * 190px;
                                    width: parent.width / parent.columns - 14px; height: 176px; border-radius: 4px;
                                    background: root.selected-media-index == item.index ? #342d43 : #27262f;
                                    border-width: 1px; border-color: root.selected-media-index == item.index ? #aa91ce : #37333e;
                                    Rectangle { x: 6px; y: 6px; width: parent.width - 12px; height: 122px; background: #101014;
                                        Image { visible: item.has-frame; source: item.frame; width: parent.width; height: parent.height; image-fit: contain; }
                                        Text { visible: !item.has-frame; text: item.status; color: #6d657c; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                    Text { x: 12px; y: 138px; width: parent.width - 24px; text: item.name; color: #d9cfdf; font-size: 11px; overflow: elide; }
                                    Text { x: 12px; y: 158px; text: item.offline ? "OFFLINE / RELINK SOURCE" : item.file-size + " · " + item.uses + " uses"; color: item.offline ? #d3a577 : #87798f; font-size: 8px; }
                                    TouchArea { clicked => { root.selected-media-index = item.index; root.selected-media = item.name; root.media-selected(item.index); } }
                                }
                                if root.media-cards.length == 0 : Text { y: 40px; width: parent.width; text: "No matching footage"; color: #8a8096; horizontal-alignment: center; }
                            }
                        }
                        HorizontalLayout { height: 36px; Action { width: 144px; with-icon: true; icon: @image-url("../../../assets/icons/folder-open.svg"); label: "Browse files…"; clicked => { root.command-invoked("project.import_media"); } } Rectangle { horizontal-stretch: 1; } Action { width: 140px; with-icon: true; icon: @image-url("../../../assets/icons/arrow-right.svg"); trailing-icon: true; label: "Continue to edit"; primary: true; enabled: root.has-project; clicked => { root.active-workspace = "EDIT"; } } }
                    }
                }
                Rectangle { width: 260px; background: #222227;
                    VerticalLayout { spacing: 16px; padding: 20px;
                        Text { text: "Import workflow"; color: #dedee8; font-size: 14px; height: 28px; }
                        Text { text: "01   Choose your media"; color: #c6bdff; height: 24px; }
                        Text { text: "Select one or more video or audio files using the native file browser."; color: #92929f; font-size: 12px; wrap: word-wrap; }
                        Text { text: "02   Build your sequence"; color: #c6bdff; height: 24px; }
                        Text { text: "Clips are appended in selection order to the appropriate unlocked tracks."; color: #92929f; font-size: 12px; wrap: word-wrap; }
                        Text { text: "03   Save your project"; color: #c6bdff; height: 24px; }
                        Text { text: "New projects prompt for a .prism destination. Existing projects save after import."; color: #92929f; font-size: 12px; wrap: word-wrap; }
                        if root.selected-media != "" : Rectangle { height: 150px; background: #111115; Image { visible: root.has-source-frame; source: root.source-frame; width: parent.width; height: parent.height; image-fit: contain; } }
                        if root.selected-media != "" : Text { text: root.selected-media; color: #b7acff; font-size: 11px; wrap: word-wrap; }
                        Rectangle { vertical-stretch: 1; }
                    }
                }
            }
        }
        if root.active-workspace == "EDIT" : Rectangle { min-width: 0px; min-height: 0px;
            VerticalLayout { spacing: 1px;
                Rectangle { height: 36px; background: #1d1d23;
                    HorizontalLayout { padding-left: 14px; padding-right: 12px; padding-top: 4px; padding-bottom: 4px; spacing: 6px;
                        Text { text: "WORKSPACE"; color: #6f6f81; font-size: 9px; vertical-alignment: center; }
                        for preset in ["Editing", "Assembly"] : Action { width: 76px; height: 27px; label: preset; quiet: true; active: root.layout-preset == preset; clicked => { root.layout-preset = preset; } }
                        Rectangle { horizontal-stretch: 1; }
                        Action { width: 32px; height: 27px; icon-only: true; icon: @image-url("../../../assets/icons/undo.svg"); label: "Undo"; hint: "Undo · Ctrl / Cmd Z"; enabled: root.can-undo; quiet: true; clicked => { root.command-invoked("edit.undo"); } }
                        Action { width: 32px; height: 27px; icon-only: true; icon: @image-url("../../../assets/icons/redo.svg"); label: "Redo"; hint: "Redo · Ctrl / Cmd Shift Z"; enabled: root.can-redo; quiet: true; clicked => { root.command-invoked("edit.redo"); } }
                        Action { width: 80px; height: 27px; label: "Save layout"; hint: "Remember this workspace for the current project"; enabled: root.has-project; quiet: true; clicked => { root.command-invoked("view.save_layout"); } }
                        Action { width: 80px; height: 27px; label: "Reset layout"; hint: "Reset this view; Save layout keeps it for next time"; quiet: true; clicked => { root.command-invoked("view.reset"); } }
                        Action { width: 72px; height: 27px; label: "Inspector"; active: root.inspector-open; quiet: true; clicked => { root.inspector-open = !root.inspector-open; } }
                    }
                }
                HorizontalLayout { spacing: 3px;
                    Rectangle { horizontal-stretch: 1;
                        VerticalLayout { spacing: 3px;
                            HorizontalLayout { height: root.monitor-height; spacing: 3px;
                                if root.layout-preset == "Editing" && !root.compact-mode : Rectangle { horizontal-stretch: 1; background: #121216;
                                    VerticalLayout { spacing: 0px;
                                        PanelBar { title: "Source"; detail: root.selected-media == "" ? "NO SOURCE" : "SOURCE CLIP"; }
                                        Rectangle { height: 28px; background: #1d1d23; Text { x: 12px; width: parent.width - 24px; text: root.selected-media == "" ? "Select footage in your project" : root.selected-media; color: #aaaab9; font-size: 11px; overflow: elide; vertical-alignment: center; } }
                                        Rectangle { vertical-stretch: 1; background: #0e0e12;
                                            Image { visible: root.has-source-frame; source: root.source-frame; width: parent.width; height: parent.height; image-fit: contain; }
                                            if !root.has-source-frame : EmptyState { heading: "The beginning of a story"; detail: root.source-detail; }
                                        }
                                        SourceRangeBar { position: root.source-ratio; range-in: root.source-in-ratio; range-out: root.source-out-ratio; available: root.source-ready; seek(ratio) => { root.source-seek(ratio); } }
                                        Text { text: "In  " + root.source-in-label + "    Out  " + root.source-out-label + "    Range  " + root.source-range-label; color: #a99bbd; font-size: 9px; height: 20px; horizontal-alignment: center; vertical-alignment: center; }
                                        HorizontalLayout { height: 34px; padding-left: 10px; padding-right: 10px; padding-top: 4px; padding-bottom: 4px; spacing: 5px;
                                            Text { text: root.source-timecode; color: #aca0eb; font-family: "monospace"; font-size: 10px; vertical-alignment: center; }
                                            Rectangle { horizontal-stretch: 1; }
                                            Action { width: 28px; height: 25px; icon-only: true; icon: @image-url("../../../assets/icons/mark-in.svg"); label: "Mark In"; hint: "Mark In"; quiet: true; enabled: root.source-ready; clicked => { root.command-invoked("source.mark_in"); } }
                                            Action { width: 28px; height: 25px; icon-only: true; icon: @image-url("../../../assets/icons/mark-out.svg"); label: "Mark Out"; hint: "Mark Out"; quiet: true; enabled: root.source-ready; clicked => { root.command-invoked("source.mark_out"); } }
                                            Action { width: 44px; height: 25px; label: "Full"; hint: "Clear In/Out marks and use the full source clip"; quiet: true; enabled: root.source-ready; clicked => { root.command-invoked("source.clear_marks"); } }
                                            Action { width: 50px; height: 25px; label: "Insert"; hint: "Insert at playhead on first video/audio tracks; shift unlocked tracks · Comma"; enabled: root.source-ready; clicked => { root.command-invoked("source.insert"); } }
                                            Action { width: 66px; height: 25px; label: "Overwrite"; hint: "Replace at playhead on first video/audio tracks · Period"; enabled: root.source-ready; clicked => { root.command-invoked("source.overwrite"); } }
                                            Action { width: 62px; height: 25px; label: "Append"; hint: "Append marked source range to the sequence"; enabled: root.source-ready; clicked => { root.command-invoked("source.append"); } }
                                        }
                                    }
                                }
                                Rectangle { horizontal-stretch: 1.35; background: #111115;
                                    VerticalLayout { spacing: 0px;
                                        PanelBar { title: "Program"; detail: root.clip-count > 0 ? root.sequence-name : "NO SEQUENCE"; }
                                        Rectangle { height: 28px; background: #1d1d23; HorizontalLayout { padding-left: 12px; padding-right: 12px; Text { text: root.sequence-name; color: #aaaab9; font-size: 11px; vertical-alignment: center; } Rectangle { horizontal-stretch: 1; } Text { text: root.clip-count == 0 ? "NO SEQUENCE" : root.playing ? (root.playback-buffering ? "BUFFERING AUDIO" : "PLAYING") : "PAUSED"; color: #767689; font-size: 8px; vertical-alignment: center; } } }
                                        Rectangle { vertical-stretch: 1; background: #0b0b0f;
                                            Image { visible: root.has-program-frame; source: root.program-frame; width: parent.width; height: parent.height; image-fit: contain; }
                                            Text { visible: !root.has-program-frame; text: root.preview-status; color: #818192; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                                            if root.show-safe-guides : Rectangle { x: parent.width * 0.1; y: parent.height * 0.1; width: parent.width * 0.8; height: parent.height * 0.8; border-width: 1px; border-color: #bcb6d480; background: transparent; }
                                            if root.show-monitor-scope && root.has-program-frame && root.program-luma-scope.length > 0 : Rectangle { x: parent.width - 150px; y: parent.height - 74px; width: 142px; height: 66px; background: #090b0ddd; border-width: 1px; border-color: #454955; border-radius: 3px;
                                                Text { x: 5px; y: 3px; text: root.program-scope-mode == 0 ? "LUMA HIST · CLICK" : root.program-scope-mode == 1 ? "LUMA WAVE · CLICK" : "VECTORSCOPE · CLICK"; color: #9da4b3; font-size: 7px; }
                                                ScopePlot { x: 5px; y: 14px; width: parent.width - 10px; height: parent.height - 19px; mode: root.program-scope-mode; histogram: root.program-luma-scope; waveform: root.program-luma-waveform; chroma: root.program-vectorscope; }
                                                TouchArea { clicked => { root.program-scope-mode = Math.mod(root.program-scope-mode + 1, 3); } }
                                            }
                                        }
                                        HorizontalLayout { height: 39px; padding-left: 12px; padding-right: 10px; padding-top: 6px; padding-bottom: 6px; spacing: 6px;
                                            Text { text: root.timecode; color: #b9acff; font-family: "monospace"; font-size: 11px; vertical-alignment: center; }
                                            Rectangle { horizontal-stretch: 1; }
                                            Action { width: 28px; height: 26px; icon-only: true; icon: @image-url("../../../assets/icons/previous-edit.svg"); label: "Previous edit"; hint: "Previous edit · ↑"; quiet: true; enabled: root.clip-count > 0; clicked => { root.command-invoked("playback.previous_edit"); } }
                                            Action { width: 28px; height: 26px; icon-only: true; icon: @image-url("../../../assets/icons/previous-frame.svg"); label: "Previous frame"; hint: "Previous frame"; quiet: true; enabled: root.clip-count > 0; clicked => { root.command-invoked("playback.step_backward"); } }
                                            Action { width: 34px; height: 26px; icon-only: true; icon: root.playing ? @image-url("../../../assets/icons/stop.svg") : @image-url("../../../assets/icons/play.svg"); label: root.playing ? "Stop playback" : "Play"; hint: "Play / Pause · Space"; active: root.playing; enabled: root.clip-count > 0; clicked => { root.command-invoked("playback.play_pause"); } }
                                            Action { width: 28px; height: 26px; icon-only: true; icon: @image-url("../../../assets/icons/next-frame.svg"); label: "Next frame"; hint: "Next frame"; quiet: true; enabled: root.clip-count > 0; clicked => { root.command-invoked("playback.step_forward"); } }
                                            Action { width: 28px; height: 26px; icon-only: true; icon: @image-url("../../../assets/icons/next-edit.svg"); label: "Next edit"; hint: "Next edit · ↓"; quiet: true; enabled: root.clip-count > 0; clicked => { root.command-invoked("playback.next_edit"); } }
                                            Rectangle { horizontal-stretch: 1; }
                                            Action { width: 42px; height: 26px; icon-only: true; icon: @image-url("../../../assets/icons/safe-guides.svg"); label: "Safe guides"; hint: "Toggle inset framing guides"; active: root.show-safe-guides; quiet: true; clicked => { root.show-safe-guides = !root.show-safe-guides; } }
                                            Text { text: root.duration-label; color: #7f7f91; font-family: "monospace"; font-size: 10px; vertical-alignment: center; }
                                        }
                                    }
                                }
                            }
                            Rectangle { height: 5px; background: resize.has-hover ? #8979cb : #303039;
                                resize := TouchArea { moved => { if self.pressed { root.monitor-height = Math.max(220px, Math.min(root.height - 360px, root.monitor-height + self.mouse-y - self.pressed-y)); } } }
                            }
                            HorizontalLayout { spacing: 3px; vertical-stretch: 1;
                                Rectangle { width: root.layout-preset == "Assembly" ? 300px : 240px; background: #202026;
                                    VerticalLayout { spacing: 0px;
                                        HorizontalLayout { height: 34px; padding-left: 8px; padding-right: 8px; spacing: 4px; padding-top: 3px; padding-bottom: 3px;
                                            for tab in ["Media", "Markers", "Info"] : Action { height: 27px; width: tab == "Info" ? 40px : 64px; label: tab; quiet: true; active: root.browser-tab == tab; clicked => { root.browser-tab = tab; } }
                                            Rectangle { horizontal-stretch: 1; }
                                            Text { visible: root.browser-tab == "Media"; text: root.media-cards.length + "/" + root.media-count; color: #717184; font-size: 8px; vertical-alignment: center; }
                                        }
                                        if root.browser-tab == "Media" : Rectangle {
                                            VerticalLayout { padding: 8px; spacing: 7px;
                                                Action { height: 25px; label: root.media-filter == 0 ? "All media" : root.media-filter == 1 ? "In sequence" : root.media-filter == 2 ? "Unused media" : "Offline media"; hint: "Cycle project media views: All, In sequence, Unused, Offline"; quiet: true; clicked => { root.media-filter = Math.mod(root.media-filter + 1, 4); root.filter-changed(); } }
                                                Field { search-field: true; placeholder-text: "Search project media"; text <=> root.search; edited => { root.filter-changed(); } }
                                                Rectangle { height: 20px; Text { x: 5px; text: "NAME"; color: #69697e; font-size: 8px; vertical-alignment: center; } Action { x: parent.width - 78px; y: 0px; width: 76px; height: 20px; label: root.media-sort == 0 ? "Project order" : root.media-sort == 1 ? "Name A–Z" : "Name Z–A"; hint: "Cycle media sorting without changing source identities"; quiet: true; clicked => { root.media-sort = Math.mod(root.media-sort + 1, 3); root.filter-changed(); } } }
                                                ScrollView { min-height: 0px; vertical-stretch: 1; VerticalLayout { spacing: 2px;
                                                    if root.media-count == 0 : EmptyState { height: 130px; heading: "A place for your footage"; detail: "Import video to start your sequence."; }
                                                    for item in root.media-cards : Rectangle { height: 42px; background: root.selected-media-index == item.index ? #363047 : media-hit.has-hover ? #2d2d37 : #25252d; border-radius: 3px;
                                                        Rectangle { x: 0px; y: 0px; width: 2px; height: parent.height; background: root.selected-media-index == item.index ? #a598ed : transparent; }
                                                        Rectangle { x: 7px; y: 7px; width: 42px; height: 28px; background: #141218; Image { visible: item.has-frame; source: item.frame; width: parent.width; height: parent.height; image-fit: contain; } Image { visible: !item.has-frame; source: @image-url("../../../assets/icons/file.svg"); width: 18px; height: 18px; x: (parent.width - 18px) / 2; y: (parent.height - 18px) / 2; colorize: #8c799f; } }
                                                        Text { x: 56px; width: parent.width - 87px; text: item.name; color: #d0cddd; overflow: elide; font-size: 10px; vertical-alignment: center; }
                                                        Text { x: parent.width - 27px; text: item.offline ? "!" : item.uses + "×"; color: item.offline ? #d3a577 : #717185; font-size: 7px; vertical-alignment: center; }
                                                        media-hit := TouchArea { clicked => { root.selected-media-index = item.index; root.selected-media = item.name; root.media-selected(item.index); } }
                                                    }
                                                    if root.media-count > 0 && root.media-cards.length == 0 : Text { height: 40px; text: "No matches"; color: #81758f; horizontal-alignment: center; }
                                                } }
                                                if root.media-count > 0 && root.media-cards.length == 0 : Action { height: 25px; label: "Clear filters"; clicked => { root.search = ""; root.media-filter = 0; root.filter-changed(); } }
                                                HorizontalLayout { height: 29px; spacing: 6px;
                                                    if root.selected-media-index >= 0 : Action { height: 29px; label: "Find in timeline"; hint: "Cycle this source's " + root.selected-media-uses + " clip references"; enabled: root.selected-media-uses > 0; clicked => { root.command-invoked("media.find_timeline"); } }
                                                    Action { with-icon: true; icon: @image-url("../../../assets/icons/import.svg"); label: "Import"; height: 29px; clicked => { root.command-invoked("project.import_media"); } }
                                                }
                                            }
                                        }
                                        if root.browser-tab == "Markers" : Rectangle {
                                            VerticalLayout { padding: 10px; spacing: 10px;
                                                HorizontalLayout { height: 30px; spacing: 6px;
                                                    Action { with-icon: true; icon: @image-url("../../../assets/icons/marker.svg"); label: "Marker"; height: 28px; enabled: root.clip-count > 0; clicked => { root.command-invoked("timeline.add_marker"); } }
                                                    Text { text: root.timeline-markers.length + " TOTAL"; color: #8c829e; font-size: 9px; vertical-alignment: center; }
                                                }
                                                ScrollView { VerticalLayout { spacing: 4px;
                                                    if root.timeline-markers.length == 0 : EmptyState { height: 140px; heading: "Remember this moment"; detail: "Add a marker at the playhead with M."; }
                                                    for marker[index] in root.timeline-markers : Rectangle { height: 49px; background: root.selected-marker-index == index ? #393044 : #27262f; border-radius: 3px;
                                                        Text { x: 10px; y: 8px; width: parent.width - 20px; text: marker.label; color: #d9c6a1; font-size: 11px; overflow: elide; }
                                                        Text { x: 10px; y: 29px; text: marker.timecode; color: #938497; font-family: "monospace"; font-size: 9px; }
                                                        TouchArea { clicked => { root.selected-marker-index = index; root.marker-label = marker.label; root.seek(marker.ratio); } }
                                                    }
                                                } }
                                                if root.selected-marker-index >= 0 : Field { text <=> root.marker-label; placeholder-text: "Marker name"; accepted => { root.command-invoked("timeline.rename_marker"); } }
                                                if root.selected-marker-index >= 0 : HorizontalLayout { height: 29px; spacing: 6px;
                                                    Action { label: "Rename"; height: 28px; clicked => { root.command-invoked("timeline.rename_marker"); } }
                                                    Action { with-icon: true; icon: @image-url("../../../assets/icons/delete.svg"); label: "Delete"; height: 28px; clicked => { root.command-invoked("timeline.delete_marker"); } }
                                                }
                                            }
                                        }
                                        if root.browser-tab == "Info" : Rectangle { VerticalLayout { padding: 14px; spacing: 14px;
                                            Text { text: "PROJECT"; color: #8e82bb; font-size: 9px; height: 16px; }
                                            Text { text: root.project-name; color: #dedbe8; font-size: 15px; wrap: word-wrap; }
                                            Text { text: root.project-summary; color: #9090a1; font-size: 11px; wrap: word-wrap; }
                                            Text { text: "WORKSPACE / " + root.workspace-status; color: #9a89b1; font-size: 10px; height: 20px; }
                                            Text { text: "LOCATION"; color: #737386; font-size: 9px; height: 16px; }
                                            Text { text: root.project-path; color: #9090a1; font-size: 10px; wrap: word-wrap; }
                                            Rectangle { vertical-stretch: 1; }
                                        } }
                                    }
                                }
                                Rectangle { width: 38px; background: #24242c;
                                    VerticalLayout { padding: 4px; spacing: 6px;
                                        Action { icon-only: true; icon: @image-url("../../../assets/icons/selection.svg"); label: "Selection tool"; hint: "Selection tool · V"; active: root.active-tool == "V"; height: 28px; clicked => { root.active-tool = "V"; } }
                                        Action { icon-only: true; icon: @image-url("../../../assets/icons/razor.svg"); label: "Razor tool"; hint: "Razor tool · C · Split a clip at the clicked frame"; active: root.active-tool == "C"; height: 28px; clicked => { root.active-tool = "C"; } }
                                        Action { icon-only: true; icon: @image-url("../../../assets/icons/trim.svg"); label: "Trim tool"; hint: root.keyboard-preset == "Premiere" ? "Trim · Adjust the nearest edge" : "Trim · T · Adjust the nearest edge"; active: root.active-tool == "T"; height: 28px; clicked => { root.active-tool = "T"; } }
                                        Action { icon-only: true; icon: @image-url("../../../assets/icons/slip.svg"); label: "Slip tool"; hint: "Slip tool · Y · Adjust source timing"; active: root.active-tool == "Y"; height: 28px; clicked => { root.active-tool = "Y"; } }
                                        Action { icon-only: true; icon: @image-url("../../../assets/icons/slide.svg"); label: "Slide tool"; hint: "Slide tool · U · Adjust the neighboring edges"; active: root.active-tool == "U"; height: 28px; clicked => { root.active-tool = "U"; } }
                                        Action { icon-only: true; icon: @image-url("../../../assets/icons/rolling.svg"); label: "Rolling edit tool"; hint: root.keyboard-preset == "Premiere" ? "Rolling Edit · N · Adjust the shared boundary" : "Rolling Edit · R · Adjust the shared boundary"; active: root.active-tool == "R"; height: 28px; clicked => { root.active-tool = "R"; } }
                                        Rectangle { vertical-stretch: 1; }
                                    }
                                }
                                Rectangle { horizontal-stretch: 1; background: #1c1c23;
                                    VerticalLayout { spacing: 0px;
                                        PanelBar { title: root.sequence-name; detail: root.clip-count + " CLIPS"; }
                                        HorizontalLayout { height: 36px; padding-left: 10px; padding-right: 8px; spacing: 5px; padding-top: 4px; padding-bottom: 4px;
                                            Text { text: root.timecode; color: #b5a9f4; font-size: 11px; font-family: "monospace"; vertical-alignment: center; }
                                            Text { text: root.active-tool + "  /  SNAP " + (root.snap-enabled ? "ON" : "OFF"); color: root.snap-enabled ? #7fb99b : #777384; font-size: 9px; vertical-alignment: center; }
                                            Rectangle { horizontal-stretch: 1; }
                                            Action { width: 28px; height: 26px; icon-only: true; icon: @image-url("../../../assets/icons/marker.svg"); label: "Add marker"; hint: "Add marker · M"; quiet: true; clicked => { root.command-invoked("timeline.add_marker"); } }
                                            Action { width: 38px; height: 26px; icon-only: true; icon: @image-url("../../../assets/icons/magnet.svg"); label: "Snapping"; hint: "Toggle snapping · S"; active: root.snap-enabled; quiet: true; clicked => { root.command-invoked("timeline.toggle_snap"); } }
                                            Action { width: 42px; height: 26px; icon-only: true; icon: @image-url("../../../assets/icons/razor.svg"); label: "Split"; hint: "Split selected clip at playhead · Ctrl / Cmd K"; quiet: true; enabled: root.selected-clip-index >= 0 && !root.inspector-locked; clicked => { root.command-invoked("timeline.split"); } }
                                            Action { width: 28px; height: 26px; icon-only: true; icon: @image-url("../../../assets/icons/zoom-out.svg"); label: "Zoom out"; hint: "Zoom timeline out"; quiet: true; enabled: root.timeline-zoom > 1; clicked => { root.timeline-zoom = Math.max(1, root.timeline-zoom / 2); root.timeline-offset = Math.min(root.timeline-offset, 1 - 1 / root.timeline-zoom); root.view-changed(); } }
                                            Action { width: 30px; height: 26px; icon-only: true; icon: @image-url("../../../assets/icons/fit.svg"); label: "Fit timeline"; hint: root.keyboard-preset == "Premiere" ? "Fit the full sequence · Backslash" : "Fit the full sequence · F"; quiet: true; enabled: root.timeline-zoom > 1; clicked => { root.command-invoked("timeline.fit"); } }
                                            Action { width: 28px; height: 26px; icon-only: true; icon: @image-url("../../../assets/icons/zoom-in.svg"); label: "Zoom in"; hint: "Zoom timeline in"; quiet: true; enabled: root.timeline-zoom < 8; clicked => { root.timeline-zoom = Math.min(8, root.timeline-zoom * 2); root.view-changed(); } }
                                        }
                                        ScrollView { vertical-stretch: 1;
                                            HorizontalLayout { spacing: 0px; min-height: Math.max(180px, root.tracks.length * 60px + 28px);
                                                Rectangle { width: 86px; background: #25252d;
                                                    VerticalLayout { spacing: 1px;
                                                        Rectangle { height: 28px; background: #292931; Text { text: "TRACKS"; color: #69697e; font-size: 8px; horizontal-alignment: center; vertical-alignment: center; } }
                                                        for track[index] in root.tracks : Rectangle { height: 59px; background: #27272f;
                                                            Text { x: 8px; y: 7px; text: track.name; color: track.audio ? #81bdac : #b6a9e5; font-size: 11px; }
                                                            Action { x: 7px; y: 29px; width: 32px; height: 23px; icon-only: true; icon: track.locked ? @image-url("../../../assets/icons/lock.svg") : @image-url("../../../assets/icons/unlock.svg"); label: "Track lock"; hint: track.locked ? "Unlock track" : "Lock track"; active: track.locked; quiet: true; clicked => { root.track-action(index, "lock"); } }
                                                            Action { x: 43px; y: 29px; width: 32px; height: 23px; icon-only: !track.audio; icon: track.visible ? @image-url("../../../assets/icons/eye.svg") : @image-url("../../../assets/icons/eye-off.svg"); label: track.audio ? "M" : "Video output"; hint: track.audio ? "Mute track" : "Toggle video output"; active: track.audio ? track.muted : !track.visible; quiet: true; clicked => { root.track-action(index, track.audio ? "mute" : "visible"); } }
                                                        }
                                                        Rectangle { vertical-stretch: 1; }
                                                    }
                                                }
                                                Rectangle { horizontal-stretch: 1; background: #1c1c23; clip: true;
                                                    Rectangle { x: 0px; y: 0px; width: parent.width; height: 28px; background: #292931;
                                                        for label[index] in root.ruler-labels : Text { visible: parent.width >= 600px || index == 0 || index == 2 || index == 5; x: Math.min(index * parent.width / 5 + 4px, parent.width - 56px); text: label; color: #8a879b; font-size: 8px; font-family: "monospace"; vertical-alignment: center; }
                                                        for marker[index] in root.timeline-markers : Rectangle { visible: marker.ratio >= root.timeline-offset && marker.ratio <= root.timeline-offset + 1 / root.timeline-zoom; x: (marker.ratio - root.timeline-offset) * root.timeline-zoom * (parent.width - 8px); y: 1px; width: 8px; height: 26px; background: transparent;
                                                            Rectangle { x: 1px; y: 1px; width: 7px; height: 7px; border-radius: 1px; background: root.selected-marker-index == index ? #f0cf78 : #d39b58; }
                                                            Rectangle { x: 3px; y: 7px; width: 1px; height: 18px; background: root.selected-marker-index == index ? #f0cf78 : #a97946; }
                                                            TouchArea { clicked => { keyboard.focus(); root.selected-marker-index = index; root.marker-label = marker.label; root.seek(marker.ratio); } }
                                                        }
                                                    }
                                                    for track[index] in root.tracks : Rectangle { y: 28px + index * 60px; width: parent.width; height: 59px; background: track.audio ? #202827 : #22222b; border-width: 1px; border-color: #30303a; }
                                                    for tick in [0,1,2,3,4,5] : Rectangle { x: tick * (parent.width - 1px) / 5; y: 28px; width: 1px; height: parent.height - 28px; background: #30303a; }
                                                    TouchArea { clicked => { keyboard.focus(); root.seek(root.timeline-offset + self.mouse-x / self.width / root.timeline-zoom); } moved => { if self.pressed { root.seek(root.timeline-offset + Math.max(0, Math.min(1, self.mouse-x / self.width)) / root.timeline-zoom); } } }
                                                    for clip[index] in root.timeline-clips : Rectangle {
                                                        x: parent.width * (clip.start-ratio - root.timeline-offset) * root.timeline-zoom; y: 32px + clip.row * 60px;
                                                        width: Math.max(3px, parent.width * clip.width-ratio * root.timeline-zoom - 2px); height: 51px; clip: true; border-radius: 3px;
                                                        background: root.selected-clip-index == index || root.selected-companion-index == index ? (clip.audio ? #477d70 : #756099) : clip.audio ? #315e53 : #4f436a;
                                                        border-width: 1px; border-color: root.selected-clip-index == index || root.selected-companion-index == index ? #decef6 : clip.audio ? #539a85 : #8d73ad;
                                                        Rectangle { x: 0px; y: 0px; width: parent.width; height: 17px; background: #ffffff0a; }
                                                        Text { x: 6px; y: 5px; width: parent.width - 12px; text: clip.name; color: #e8dff3; font-size: 9px; overflow: elide; }
                                                        if clip.audio : Rectangle { x: 4px; y: 20px; width: parent.width - 8px; height: 27px; background: #14262255;
                                                            Rectangle { y: parent.height / 2; width: parent.width; height: 1px; background: #78b6a433; }
                                                            for peak[peak-index] in clip.waveform : Rectangle {
                                                                x: peak-index * parent.width / clip.waveform.length;
                                                                width: Math.max(1px, parent.width / clip.waveform.length - 1px);
                                                                height: Math.max(1px, peak * (parent.height - 3px));
                                                                y: (parent.height - self.height) / 2;
                                                                background: #8bcbb8cc;
                                                            }
                                                            if clip.waveform.length == 0 : Text { text: "WAVEFORM"; color: #88a59d; font-size: 7px; vertical-alignment: center; horizontal-alignment: center; }
                                                        }
                                                        if !clip.audio : Text { x: 6px; y: 32px; text: "VIDEO"; color: #c1afd6; font-size: 7px; }
                                                        clip-drag := TouchArea { x: 7px; width: parent.width - 14px; clicked => { keyboard.focus(); root.selected-clip-index = index; root.clip-selected(index); root.seek(clip.start-ratio + Math.max(0, Math.min(1, self.mouse-x / self.width)) * clip.width-ratio); if root.active-tool == "C" { root.command-invoked("timeline.split"); } } pointer-event(event) => { if event.kind == PointerEventKind.up && root.active-tool != "C" && Math.abs(self.mouse-x - self.pressed-x) > 3px { root.clip-adjusted(index, (self.mouse-x - self.pressed-x) / self.width * clip.width-ratio, root.active-tool == "V" ? "move" : root.active-tool == "T" ? (self.pressed-x < self.width / 2 ? "in" : "out") : root.active-tool == "Y" ? "slip" : root.active-tool == "U" ? "slide" : root.active-tool == "R" ? (self.pressed-x < self.width / 2 ? "roll_in" : "roll_out") : "none"); } } }
                                                        TouchArea { width: 7px; mouse-cursor: ew-resize; pointer-event(event) => { if event.kind == PointerEventKind.up && Math.abs(self.mouse-x - self.pressed-x) > 2px { root.clip-adjusted(index, (self.mouse-x - self.pressed-x) / parent.width * clip.width-ratio, "in"); } } }
                                                        TouchArea { x: parent.width - 7px; width: 7px; mouse-cursor: ew-resize; pointer-event(event) => { if event.kind == PointerEventKind.up && Math.abs(self.mouse-x - self.pressed-x) > 2px { root.clip-adjusted(index, (self.mouse-x - self.pressed-x) / parent.width * clip.width-ratio, "out"); } } }
                                                    }
                                                    for transition in root.timeline-transitions : Rectangle { x: parent.width * (transition.ratio - transition.width-ratio / 2 - root.timeline-offset) * root.timeline-zoom; y: 36px + transition.row * 60px; width: Math.max(14px, parent.width * transition.width-ratio * root.timeline-zoom); height: 15px; border-radius: 2px; background: #b48b4dcc; border-width: 1px; border-color: #e2bd72; Text { text: "D"; color: #211a12; font-size: 8px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; } }
                                                    Rectangle { x: (root.playhead-ratio - root.timeline-offset) * root.timeline-zoom * (parent.width - 1px); y: 0px; width: 1px; height: parent.height; background: #c4b3f8; }
                                                    Rectangle { x: (root.playhead-ratio - root.timeline-offset) * root.timeline-zoom * (parent.width - 1px) - 3px; y: 0px; width: 7px; height: 9px; background: #c4b3f8; }
                                                    if root.clip-count == 0 : Text { y: 77px; width: parent.width; text: "Your story takes shape here"; color: #717184; font-size: 11px; horizontal-alignment: center; }
                                                }
                                            }
                                        }
                                        Rectangle { height: 13px; background: #24242c;
                                            Rectangle { x: parent.width * root.timeline-offset; y: 3px; width: parent.width / root.timeline-zoom; height: 7px; border-radius: 4px; background: #595368; }
                                            TouchArea { clicked => { root.timeline-offset = Math.max(0, Math.min(1 - 1 / root.timeline-zoom, self.mouse-x / self.width - 0.5 / root.timeline-zoom)); root.view-changed(); } moved => { if self.pressed { root.timeline-offset = Math.max(0, Math.min(1 - 1 / root.timeline-zoom, self.mouse-x / self.width - 0.5 / root.timeline-zoom)); root.view-changed(); } } }
                                        }
                                        Rectangle { height: 24px; background: #24242c; Text { x: 10px; text: root.keyboard-preset == "Premiere" ? "V SELECT   C RAZOR   Y SLIP   U SLIDE   N ROLL" : "V SELECT   C RAZOR   T TRIM   Y SLIP   U SLIDE   R ROLL"; color: #727186; font-size: 8px; vertical-alignment: center; } }
                                    }
                                }
                            }
                        }
                    }
                    if root.inspector-open : Rectangle { width: 258px; background: #202026;
                        VerticalLayout { spacing: 0px;
                            PanelBar { title: root.inspector-tab; detail: "PRISM / INSPECT"; }
                            if root.inspector-tab == "Properties" : ScrollView { VerticalLayout { padding: 14px; spacing: 11px;
                                HorizontalLayout { height: 30px; spacing: 6px;
                                    for section in ["Clip", "Source"] : Action { label: section; height: 28px; active: root.inspector-section == section; quiet: true; clicked => { root.inspector-section = section; } }
                                }
                                Text { text: root.inspector-section == "Clip" ? (root.inspector-name == "" ? "Choose a clip" : root.inspector-name) : (root.selected-media == "" ? "Choose source footage" : root.selected-media); color: #e5deed; font-size: 16px; wrap: word-wrap; }
                                if root.inspector-section == "Clip" : Text { text: root.selected-clip-index >= 0 ? root.inspector-track + (root.inspector-locked ? " / LOCKED" : root.selected-is-audio ? " / AUDIO CLIP" : " / VIDEO CLIP") : "Select a clip in the timeline to edit its timing. Browse Source to manage your media."; color: #89869c; font-size: 11px; wrap: word-wrap; }
                                if root.inspector-section == "Clip" : VerticalLayout { spacing: 11px;
                                if root.selected-clip-index >= 0 && root.selected-is-audio : WaveformStrip { peaks: root.selected-waveform; }
                                if root.selected-track-index >= 0 : HorizontalLayout { height: 28px; spacing: 6px; Action { label: "Track ↑"; height: 27px; enabled: root.selected-track-index > 0; clicked => { root.command-invoked("timeline.track_up"); } } Action { label: "Track ↓"; height: 27px; enabled: root.selected-track-index + 1 < root.tracks.length; clicked => { root.command-invoked("timeline.track_down"); } } }
                                if root.selected-clip-index >= 0 : Action { label: "Match frame in Source"; hint: "Find the selected clip's original source frame"; clicked => { root.command-invoked("source.match_frame"); } }
                                if root.selected-clip-index >= 0 : Action { with-icon: true; icon: root.paired-tools-open ? @image-url("../../../assets/icons/chevron-down.svg") : @image-url("../../../assets/icons/chevron-right.svg"); label: "Edit aligned A/V"; quiet: true; clicked => { root.paired-tools-open = !root.paired-tools-open; } }
                                if root.paired-tools-open && root.selected-clip-index >= 0 : VerticalLayout { spacing: 8px;
                                    Text { text: root.aligned-av-detail; color: root.can-edit-av ? #9bb9ae : #bd9b86; font-size: 10px; wrap: word-wrap; }
                                    HorizontalLayout { height: 29px; spacing: 6px;
                                        Action { label: "Split A/V"; hint: "Split the matching picture and sound together"; enabled: root.can-edit-av; clicked => { root.command-invoked("timeline.split_av"); } }
                                        Action { with-icon: true; icon: @image-url("../../../assets/icons/delete.svg"); label: "Delete A/V"; hint: "Remove both aligned clips, leaving their gaps"; enabled: root.can-edit-av; clicked => { root.command-invoked("timeline.delete_av"); } }
                                    }
                                    Action { label: "Ripple delete A/V"; hint: "Remove matching picture and sound and close time on both tracks"; enabled: root.can-edit-av; clicked => { root.command-invoked("timeline.ripple_delete_av"); } }
                                    Text { text: "Move both to · seconds or fraction"; color: #9994a8; font-size: 10px; }
                                    Field { text <=> root.paired-start; enabled: root.can-edit-av; }
                                    Action { label: "Move A/V together"; hint: "Reposition both matching clips in one undo step"; enabled: root.can-edit-av; clicked => { root.command-invoked("timeline.move_av"); } }
                                    Text { text: "Source In · seconds or fraction"; color: #9994a8; font-size: 10px; }
                                    Field { text <=> root.paired-source-in; enabled: root.can-edit-av; }
                                    Text { text: "Duration · seconds or fraction"; color: #9994a8; font-size: 10px; }
                                    Field { text <=> root.paired-duration; enabled: root.can-edit-av; }
                                    Action { label: "Apply A/V source range"; hint: "Change both source ranges while keeping their sequence start"; enabled: root.can-edit-av; clicked => { root.command-invoked("timeline.trim_av"); } }
                                }
                                if root.selected-clip-index >= 0 : Text { text: "CLIP TIMING"; color: #a69ac1; font-size: 9px; height: 18px; }
                                if root.selected-clip-index >= 0 : Text { text: "Sequence start · seconds"; color: #9994a8; font-size: 10px; height: 16px; }
                                if root.selected-clip-index >= 0 : Field { text <=> root.clip-start; enabled: !root.inspector-locked; }
                                if root.selected-clip-index >= 0 : HorizontalLayout { height: 28px; spacing: 6px; Action { label: "Move −1f"; height: 27px; enabled: !root.inspector-locked; clicked => { root.command-invoked("timeline.move_left"); } } Action { label: "Move +1f"; height: 27px; enabled: !root.inspector-locked; clicked => { root.command-invoked("timeline.move_right"); } } }
                                if root.selected-clip-index >= 0 : Text { text: "Source in · seconds"; color: #9994a8; font-size: 10px; height: 16px; }
                                if root.selected-clip-index >= 0 : Field { text <=> root.clip-source-in; enabled: !root.inspector-locked; }
                                if root.selected-clip-index >= 0 : HorizontalLayout { height: 28px; spacing: 6px; Action { label: "In −1f"; height: 27px; enabled: !root.inspector-locked; clicked => { root.command-invoked("timeline.trim_in_left"); } } Action { label: "In +1f"; height: 27px; enabled: !root.inspector-locked; clicked => { root.command-invoked("timeline.trim_in_right"); } } }
                                if root.selected-clip-index >= 0 : Text { text: "Duration · seconds"; color: #9994a8; font-size: 10px; height: 16px; }
                                if root.selected-clip-index >= 0 : Field { text <=> root.clip-duration; enabled: !root.inspector-locked; }
                                if root.selected-clip-index >= 0 : HorizontalLayout { height: 28px; spacing: 6px; Action { label: "Out −1f"; height: 27px; enabled: !root.inspector-locked; clicked => { root.command-invoked("timeline.trim_out_left"); } } Action { label: "Out +1f"; height: 27px; enabled: !root.inspector-locked; clicked => { root.command-invoked("timeline.trim_out_right"); } } }
                                if root.selected-clip-index >= 0 : Text { text: "Use seconds or an exact fraction, e.g. 1.5 or 3/2."; color: #6e6b7e; font-size: 10px; wrap: word-wrap; }
                                if root.selected-clip-index >= 0 : Action { label: "Apply timing"; primary: true; enabled: !root.inspector-locked; clicked => { root.command-invoked("timeline.apply_timing"); } }
                                if root.selected-clip-index >= 0 : Action { label: root.selected-has-transition ? "Remove dissolve" : "Add dissolve at clip end"; enabled: !root.inspector-locked && root.selected-has-next; clicked => { root.command-invoked("timeline.toggle_dissolve"); } }
                                if root.selected-clip-index >= 0 : Action { with-icon: true; icon: @image-url("../../../assets/icons/duplicate.svg"); label: "Duplicate to track end"; enabled: !root.inspector-locked; clicked => { root.command-invoked("timeline.duplicate"); } }
                                if root.selected-clip-index >= 0 : HorizontalLayout { height: 29px; spacing: 6px;
                                    Action { with-icon: true; icon: @image-url("../../../assets/icons/delete.svg"); label: "Delete"; height: 28px; hint: "Delete clip and leave its gap"; enabled: !root.inspector-locked; clicked => { root.command-invoked("timeline.delete"); } }
                                    Action { label: "Ripple delete"; height: 28px; hint: "Delete clip and close time on its track"; enabled: !root.inspector-locked; clicked => { root.command-invoked("timeline.ripple_delete"); } }
                                }
                                if root.selected-clip-index >= 0 : Action { with-icon: true; icon: root.precision-open ? @image-url("../../../assets/icons/chevron-down.svg") : @image-url("../../../assets/icons/chevron-right.svg"); label: "Precision edits"; quiet: true; clicked => { root.precision-open = !root.precision-open; } }
                                if root.precision-open : VerticalLayout { spacing: 8px;
                                if root.selected-clip-index >= 0 : Text { text: "PRECISION EDITS"; color: #a69ac1; font-size: 9px; height: 18px; }
                                if root.selected-clip-index >= 0 : Text { text: root.selected-companion-index >= 0 ? "Slip edits aligned A/V · Roll and Slide edit this track" : "Precision edits affect the selected track"; color: #777386; font-size: 9px; height: 20px; wrap: word-wrap; }
                                if root.selected-clip-index >= 0 : HorizontalLayout { height: 28px; spacing: 6px; Action { label: "Slip −1f"; height: 27px; enabled: !root.inspector-locked; clicked => { root.command-invoked("timeline.slip_left"); } } Action { label: "Slip +1f"; height: 27px; enabled: !root.inspector-locked; clicked => { root.command-invoked("timeline.slip_right"); } } }
                                if root.selected-clip-index >= 0 : HorizontalLayout { height: 28px; spacing: 6px; Action { label: "Roll In −1f"; height: 27px; enabled: !root.inspector-locked; clicked => { root.command-invoked("timeline.roll_in_left"); } } Action { label: "Roll In +1f"; height: 27px; enabled: !root.inspector-locked; clicked => { root.command-invoked("timeline.roll_in_right"); } } }
                                if root.selected-clip-index >= 0 : HorizontalLayout { height: 28px; spacing: 6px; Action { label: "Roll Out −1f"; height: 27px; enabled: !root.inspector-locked; clicked => { root.command-invoked("timeline.roll_out_left"); } } Action { label: "Roll Out +1f"; height: 27px; enabled: !root.inspector-locked; clicked => { root.command-invoked("timeline.roll_out_right"); } } }
                                if root.selected-clip-index >= 0 : HorizontalLayout { height: 28px; spacing: 6px; Action { label: "Slide −1f"; height: 27px; enabled: !root.inspector-locked; clicked => { root.command-invoked("timeline.slide_left"); } } Action { label: "Slide +1f"; height: 27px; enabled: !root.inspector-locked; clicked => { root.command-invoked("timeline.slide_right"); } } }
                                }
                                }
                                if root.inspector-section == "Source" : VerticalLayout { spacing: 11px;
                                Rectangle { height: 1px; background: #393540; }
                                Text { text: root.source-file-status; color: root.source-ready ? #88b39e : #c39c7b; font-size: 10px; wrap: word-wrap; }
                                if root.selected-media-index >= 0 && !root.source-ready : Action { label: "Relink source…"; hint: "Locate the original footage on your computer"; clicked => { root.command-invoked("media.relink_source"); } }
                                Text { text: root.source-preview-size; color: #8f849f; font-size: 10px; wrap: word-wrap; }
                                Text { text: "SOURCE RANGE"; color: #a69ac1; font-size: 9px; height: 18px; }
                                if root.selected-media != "" : Rectangle { height: 82px; background: #101014; Image { visible: root.has-source-frame; source: root.source-frame; width: parent.width; height: parent.height; image-fit: contain; } }
                                        SourceRangeBar { position: root.source-ratio; range-in: root.source-in-ratio; range-out: root.source-out-ratio; available: root.source-ready; seek(ratio) => { root.source-seek(ratio); } }
                                 HorizontalLayout { height: 27px; spacing: 6px;
                                    Text { text: root.source-timecode; color: #a79cb9; font-family: "monospace"; font-size: 10px; vertical-alignment: center; }
                                    Rectangle { horizontal-stretch: 1; }
                                    Action { icon-only: true; icon: @image-url("../../../assets/icons/mark-in.svg"); label: "Mark In"; hint: "Mark In"; width: 36px; height: 26px; enabled: root.source-ready; clicked => { root.command-invoked("source.mark_in"); } }
                                    Action { icon-only: true; icon: @image-url("../../../assets/icons/mark-out.svg"); label: "Mark Out"; hint: "Mark Out"; width: 36px; height: 26px; enabled: root.source-ready; clicked => { root.command-invoked("source.mark_out"); } }
                                }
                                Text { text: "In    " + root.source-in-label + "\nOut  " + root.source-out-label; color: #9891ac; font-size: 10px; font-family: "monospace"; height: 32px; }
                                Text { text: "RANGE  " + root.source-range-label; color: #bdacd4; font-size: 10px; font-family: "monospace"; height: 18px; }
                                Action { label: "Use full clip"; hint: "Clear source In/Out marks"; enabled: root.source-ready; clicked => { root.command-invoked("source.clear_marks"); } }
                                Text { height: 45px; text: "Insert/Overwrite → first video/audio tracks. Insert shifts unlocked tracks. Source patching and sync-lock controls are not available yet."; color: #a69eaf; font-size: 10px; wrap: word-wrap; }
                                HorizontalLayout { height: 30px; spacing: 6px;
                                    Action { label: "Insert"; hint: "Insert at playhead · Comma in Premiere preset"; enabled: root.source-ready; clicked => { root.command-invoked("source.insert"); } }
                                    Action { label: "Overwrite"; hint: "Replace at playhead · Period in Premiere preset"; enabled: root.source-ready; clicked => { root.command-invoked("source.overwrite"); } }
                                }
                                Action { label: "Append marked source"; enabled: root.source-ready; clicked => { root.command-invoked("source.append"); } }
                                Text { text: "Edits are validated and saved locally. Original media stays untouched."; color: #6e6b7e; font-size: 10px; wrap: word-wrap; }
                                Action { with-icon: true; icon: root.media-tools-open ? @image-url("../../../assets/icons/chevron-down.svg") : @image-url("../../../assets/icons/chevron-right.svg"); label: "Media & proxies"; quiet: true; hint: "Relink footage and manage background proxies"; clicked => { root.media-tools-open = !root.media-tools-open; } }
                                if root.media-tools-open : VerticalLayout { spacing: 11px;
                                if root.selected-media-index >= 0 : Text { text: "SOURCE FILE"; color: #a69ac1; font-size: 9px; height: 18px; }
                                if root.selected-media-index >= 0 : Text { text: root.selected-source-path; color: #8c879c; font-size: 10px; wrap: word-wrap; }
                                if root.selected-media-index >= 0 : Action { label: "Relink source…"; clicked => { root.command-invoked("media.relink_source"); } }
                                if root.selected-media-index >= 0 : Text { text: "PROXY"; color: #a69ac1; font-size: 9px; height: 18px; }
                                if root.selected-media-index >= 0 : Text { text: root.selected-proxy == "" ? "No proxy assigned" : root.selected-proxy; color: #8c879c; font-size: 10px; wrap: word-wrap; }
                                if root.selected-media-index >= 0 : Text { text: "STATUS  " + root.proxy-status; color: root.proxy-status == "AVAILABLE" ? #79b89d : root.proxy-status == "STALE" ? #d0a85c : #9a8490; font-size: 9px; height: 16px; }
                                if root.selected-media-index >= 0 : HorizontalLayout { height: 30px; spacing: 6px; Action { with-icon: true; icon: @image-url("../../../assets/icons/link.svg"); label: "Assign"; height: 28px; clicked => { root.command-invoked("media.assign_proxy"); } } Action { with-icon: true; icon: @image-url("../../../assets/icons/unlink.svg"); label: "Clear"; height: 28px; enabled: root.selected-proxy != ""; clicked => { root.command-invoked("media.clear_proxy"); } } }
                                if root.selected-media-index >= 0 : Action { label: root.proxy-generating ? "Cancel proxy generation" : root.selected-proxy == "" ? "Generate 540p proxy" : root.proxy-status == "AVAILABLE" ? "Proxy is current" : "Regenerate proxy"; enabled: root.proxy-generating || root.proxy-status != "AVAILABLE"; clicked => { root.command-invoked(root.proxy-generating ? "media.cancel_proxy" : root.selected-proxy == "" ? "media.generate_proxy" : "media.regenerate_proxy"); } }
                                if root.selected-media-index >= 0 : Action { label: root.proxy-active ? "Using proxy" : "Use original"; active: root.proxy-active; enabled: root.proxy-status == "AVAILABLE"; clicked => { root.command-invoked("media.toggle_proxy"); } }
                                }
                                }
                            } }
                            if root.inspector-tab == "Scopes" : ScrollView { VerticalLayout { padding: 14px; spacing: 12px;
                                Text { text: "Program analysis"; color: #e5deed; font-size: 16px; }
                                Text { text: root.has-program-frame ? "Decoded preview · " + (root.playing ? "Playback sampling" : "Paused frame") : "No decoded Program frame"; color: #aaa2b4; font-size: 10px; wrap: word-wrap; }
                                HorizontalLayout { height: 29px; spacing: 4px;
                                    for label[index] in ["Hist", "Wave", "Vector"] : Action { label: label; height: 28px; active: root.program-scope-mode == index; hint: index == 0 ? "Luma histogram" : index == 1 ? "Luma waveform" : "Chroma vectorscope"; clicked => { root.program-scope-mode = index; } }
                                }
                                Text { text: root.program-scope-mode == 0 ? "LUMA HISTOGRAM" : root.program-scope-mode == 1 ? "LUMA WAVEFORM" : "CHROMA VECTORSCOPE"; color: #b3a6c7; font-size: 10px; }
                                Rectangle { height: 230px; background: #101319; border-width: 1px; border-color: #45414f;
                                    if root.has-program-frame : ScopePlot { x: 8px; y: 8px; width: parent.width - 16px; height: parent.height - 16px; mode: root.program-scope-mode; histogram: root.program-luma-scope; waveform: root.program-luma-waveform; chroma: root.program-vectorscope; }
                                    if !root.has-program-frame : Text { text: "Play or scrub a video clip\nto inspect its decoded image"; color: #888493; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; wrap: word-wrap; }
                                }
                                Text { text: root.program-scope-mode == 0 ? "0 · Shadows          Midtones          Highlights · 255" : root.program-scope-mode == 1 ? "Left → right: image position\nBottom → top: luma code 0 → 255" : "Center: neutral color\nHorizontal: Cb · Vertical: Cr"; color: #9c94a9; font-size: 10px; wrap: word-wrap; }
                                Text { text: root.program-scope-mode == 0 ? "Bar height shows relative sample count. Red edge bins flag samples near black or white." : root.program-scope-mode == 1 ? "Each column shows its sampled luma range. Red guides mark code values 16 and 235." : "Brighter cells contain more sampled chroma values. This is a coarse preview of color distribution."; color: #aaa2b4; font-size: 11px; wrap: word-wrap; }
                                Action { label: root.show-monitor-scope ? "Hide monitor overlay" : "Show monitor overlay"; active: root.show-monitor-scope; clicked => { root.show-monitor-scope = !root.show-monitor-scope; } }
                                Text { text: "Analyzes sampled 8-bit preview pixels. These guides are not a calibrated broadcast or HDR compliance check. No color correction is applied."; color: #8a8497; font-size: 10px; wrap: word-wrap; }
                            } }
                            if root.inspector-tab == "Shortcuts" : ScrollView { VerticalLayout { padding: 14px; spacing: 10px;
                                Text { height: 24px; text: "Keyboard preset"; color: #e5deed; font-size: 16px; }
                                HorizontalLayout { height: 29px; spacing: 5px;
                                    for preset in ["Premiere", "Prism"] : Action { label: preset; active: root.keyboard-preset == preset; clicked => { root.keyboard-preset = preset; } }
                                }
                                Text { height: 55px; text: "Premiere maps the implemented editing subset. Missing commands stay reserved and report their gap. Save layout remembers this choice for the project."; color: #a69eaf; font-size: 10px; wrap: word-wrap; }
                                Field { height: 30px; search-field: true; text <=> root.shortcut-query; placeholder-text: "Find a command or key"; edited => { root.shortcuts-changed(); } }
                                for item in root.shortcut-items : Rectangle { height: 84px; background: #25232c; border-radius: 3px;
                                    Text { x: 8px; y: 7px; width: parent.width - 16px; text: item.keys + "  ·  " + item.name; color: item.available ? #d7cde9 : #c6a58e; font-size: 11px; wrap: word-wrap; }
                                    Text { x: 8px; y: 35px; width: parent.width - 16px; text: (item.available ? "Available · " : "Not built · ") + item.detail; color: #a39aaa; font-size: 10px; wrap: word-wrap; }
                                }
                                if root.shortcut-items.length == 0 : Text { text: "No matching shortcut"; color: #a39aaa; font-size: 11px; }
                            } }
                            if root.inspector-tab == "History" : Rectangle { VerticalLayout { padding: 14px; spacing: 12px;
                                Text { text: "Every decision. Reversible."; color: #c9bfdd; font-size: 12px; height: 28px; }
                                HorizontalLayout { height: 29px; spacing: 8px; Action { label: "Undo"; enabled: root.can-undo; clicked => { root.command-invoked("edit.undo"); } } Action { label: "Redo"; enabled: root.can-redo; clicked => { root.command-invoked("edit.redo"); } } }
                                ScrollView { VerticalLayout { spacing: 4px; for item in root.history-items : Rectangle { height: 35px; background: item.applied ? #2c2836 : #23232b; border-radius: 3px; Text { x: 10px; width: parent.width - 20px; text: (item.applied ? "•  " : "↶  ") + item.label; color: item.applied ? #bdb1d0 : #646174; font-size: 10px; overflow: elide; vertical-alignment: center; } } } }
                                Text { text: "Session history · up to 50 edits"; color: #6e6b7e; font-size: 9px; height: 18px; }
                            } }
                            if root.inspector-tab == "Jobs" : ScrollView { VerticalLayout { padding: 16px; spacing: 14px;
                                Text { text: "PROJECT SAFETY"; color: #a69ac1; font-size: 9px; height: 16px; }
                                Text { text: "AUTOSAVE  /  " + root.autosave-status; color: root.autosave-status == "FAILED" ? #db9b9f : #8fb9a5; font-size: 11px; height: 20px; }
                                HorizontalLayout { height: 28px; spacing: 6px; Action { label: root.autosave-enabled ? "Autosave on" : "Autosave off"; active: root.autosave-enabled; enabled: root.autosave-status != "UNAVAILABLE"; clicked => { root.command-invoked("autosave.toggle"); } } Action { label: "Keep " + root.autosave-retention; enabled: root.autosave-status != "UNAVAILABLE"; clicked => { root.command-invoked("autosave.retention"); } } }
                                Rectangle { height: 1px; background: #393540; }
                                Text { text: "MEDIA PREPARATION"; color: #a69ac1; font-size: 9px; height: 16px; }
                                Text { text: "CODECS  /  " + root.codec-status; color: root.codec-status == "READY" ? #8fb9a5 : #db9b9f; font-size: 11px; height: 20px; }
                                Text { text: root.codec-detail; color: #8c879c; font-size: 10px; height: 18px; overflow: elide; }
                                Text { text: "THUMBNAILS  /  " + root.media-task-status; color: root.media-task-status == "COMPLETE WITH ERRORS" ? #d0a85c : #ded2f2; font-size: 11px; height: 20px; }
                                Text { text: root.media-task-detail + (root.media-task-pending > 0 ? " · " + root.media-task-pending + " pending" : ""); color: #8c879c; font-size: 10px; height: 18px; }
                                Text { text: "PROXY  /  " + (root.proxy-generating ? "GENERATING" : root.proxy-status); color: root.proxy-generating ? #d0a85c : #8fb9a5; font-size: 11px; height: 20px; }
                                Text { text: "CACHE  /  " + root.cache-status; color: root.cache-status == "FAILED" ? #db9b9f : root.cache-cleaning ? #d0a85c : #8fb9a5; font-size: 11px; height: 20px; }
                                Text { text: root.cache-detail; color: #8c879c; font-size: 10px; height: 18px; overflow: elide; }
                                Action { label: root.cache-cleaning ? "Cleaning derived cache…" : "Clean derived cache"; enabled: !root.cache-cleaning && root.cache-status != "UNAVAILABLE"; clicked => { root.command-invoked("cache.clean"); } }
                                Rectangle { height: 1px; background: #393540; }
                                Text { text: "EXPORT"; color: #a69ac1; font-size: 9px; height: 16px; }
                                Text { text: root.export-status; color: #ded2f2; font-size: 18px; height: 28px; }
                                Text { text: root.export-output; color: #8c879c; font-size: 10px; wrap: word-wrap; }
                                Rectangle { height: 4px; background: #34303f; Rectangle { x: 0px; y: 0px; height: parent.height; width: parent.width * Math.max(0, root.export-progress) / 100; background: #a28bd0; } }
                                Text { text: root.export-error; color: #db9b9f; font-size: 10px; wrap: word-wrap; }
                                Action { visible: root.export-can-cancel; with-icon: true; icon: @image-url("../../../assets/icons/close.svg"); label: "Cancel export"; clicked => { root.command-invoked("export.cancel"); } }
                                Action { visible: root.export-can-retry; label: "Retry export"; clicked => { root.command-invoked("export.retry"); } }
                                Action { with-icon: true; icon: @image-url("../../../assets/icons/export.svg"); label: "Export settings"; clicked => { root.active-workspace = "EXPORT"; } }
                                Rectangle { vertical-stretch: 1; }
                            } }
                        }
                    }
                    Rectangle { width: 56px; background: #24242c;
                        VerticalLayout { padding: 4px; spacing: 7px;
                            Action { label: "Props"; hint: "Clip and source properties"; active: root.inspector-open && root.inspector-tab == "Properties"; quiet: true; clicked => { root.inspector-tab = "Properties"; root.inspector-open = true; } }
                            Action { label: "Scopes"; hint: "Inspect Program brightness and chroma"; active: root.inspector-open && root.inspector-tab == "Scopes"; quiet: true; clicked => { root.command-invoked("view.scopes"); } }
                            Action { label: "History"; hint: "Edit history"; active: root.inspector-open && root.inspector-tab == "History"; quiet: true; clicked => { root.inspector-tab = "History"; root.inspector-open = true; } }
                            Action { label: "Keys"; hint: "Keyboard presets and command coverage"; active: root.inspector-open && root.inspector-tab == "Shortcuts"; quiet: true; clicked => { root.command-invoked("view.shortcuts"); } }
                            Action { label: "Jobs"; hint: "Autosave, media preparation, cache and exports"; active: root.inspector-open && root.inspector-tab == "Jobs"; quiet: true; clicked => { root.inspector-tab = "Jobs"; root.inspector-open = true; } }
                            Rectangle { vertical-stretch: 1; }
                            Action { label: root.inspector-open ? "›" : "‹"; hint: "Toggle inspector panel"; quiet: true; clicked => { root.inspector-open = !root.inspector-open; } }
                        }
                    }
                }
            }
        }
        if root.active-workspace == "EXPORT" : Rectangle {
            HorizontalLayout { spacing: 1px;
                Rectangle { width: 380px; background: #222227;
                    VerticalLayout { padding: 22px; spacing: 12px;
                        ScrollView { VerticalLayout { spacing: 12px;
                        Text { text: "The finishing touch."; color: #eeeef4; font-size: 25px; height: 40px; }
                        Text { text: "EXPORT SETTINGS"; color: #92929f; font-size: 10px; height: 20px; }
                        Text { text: "Output file"; color: #c7c7d2; height: 20px; }
                        Field { text <=> root.export-output; enabled: !root.export-can-cancel; placeholder-text: "Choose an MP4 destination"; }
                        Action { with-icon: true; icon: @image-url("../../../assets/icons/folder-open.svg"); label: "Choose destination…"; enabled: !root.export-can-cancel; clicked => { root.command-invoked("export.destination"); } }
                        Text { text: "FORMAT"; color: #80808e; font-size: 10px; height: 22px; }
                        Text { text: "H.264 / MP4"; color: #dedee8; font-size: 14px; height: 22px; }
                        Text { text: "OUTPUT SIZE"; color: #80808e; font-size: 10px; height: 18px; }
                        HorizontalLayout { height: 32px; spacing: 8px;
                            Action { label: "1080p"; active: root.export-preset-index == 0; enabled: !root.export-can-cancel; clicked => { root.export-preset-index = 0; } }
                            Action { label: "4K UHD"; active: root.export-preset-index == 1; enabled: !root.export-can-cancel; clicked => { root.export-preset-index = 1; } }
                            Action { label: "Vertical"; active: root.export-preset-index == 2; enabled: !root.export-can-cancel; clicked => { root.export-preset-index = 2; } }
                            Action { label: "Square"; active: root.export-preset-index == 3; enabled: !root.export-can-cancel; clicked => { root.export-preset-index = 3; } }
                        }
                        Text { text: root.export-preset-index == 0 ? "1920 × 1080 · 29.97 fps · 8 Mbps" : root.export-preset-index == 1 ? "3840 × 2160 · 29.97 fps · 35 Mbps" : root.export-preset-index == 2 ? "1080 × 1920 · 29.97 fps · 8 Mbps" : "1080 × 1080 · 29.97 fps · 8 Mbps"; color: #92929f; font-size: 11px; height: 22px; }
                        Text { text: root.export-video-summary + "\n" + root.export-audio-summary; color: #aaa2b4; font-size: 11px; wrap: word-wrap; }
                        Rectangle { height: 1px; background: #3a3a44; }
                        Text { text: "Composites every visible video track, renders dissolves, and mixes every unmuted audio track."; color: #9696a4; font-size: 12px; wrap: word-wrap; }
                        Text { text: root.export-preflight; color: root.can-export ? #8fb9a5 : #d0aa7f; font-size: 11px; wrap: word-wrap; }
                        } }
                        Action { with-icon: true; icon: @image-url("../../../assets/icons/export.svg"); label: root.export-can-cancel ? "Exporting…" : "Export sequence"; primary: true; height: 40px; enabled: root.can-export && !root.export-can-cancel; clicked => { root.command-invoked("export.queue"); } }
                    }
                }
                Rectangle { horizontal-stretch: 1; background: #19191e;
                    VerticalLayout { padding: 26px; spacing: 14px;
                        PanelBar { title: "Output preview"; detail: root.project-name; }
                        Rectangle { vertical-stretch: 1; background: #0e0e11;
                            Image { visible: root.has-program-frame; source: root.program-frame; width: parent.width; height: parent.height; image-fit: contain; }
                            Text { visible: !root.has-program-frame; text: root.has-project ? "Scrub your sequence in Edit to preview a frame" : "Open a project with video to export"; color: #858592; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        Text { text: "EXPORT JOB  /  " + root.export-status; color: #b7acff; font-size: 12px; height: 24px; }
                        Rectangle { height: 5px; background: #303037; Rectangle { width: parent.width * Math.max(0, root.export-progress) / 100; height: parent.height; background: #a397ff; } }
                        Text { text: root.export-error; color: #ec9c9c; font-size: 12px; wrap: word-wrap; height: 50px; }
                        HorizontalLayout { height: 32px; spacing: 10px; Action { visible: root.export-can-cancel; label: "Cancel export"; width: 120px; clicked => { root.command-invoked("export.cancel"); } } Action { visible: root.export-can-retry; with-icon: true; icon: @image-url("../../../assets/icons/retry.svg"); label: "Retry"; width: 80px; clicked => { root.command-invoked("export.retry"); } } Action { visible: root.export-can-remove; label: "Clear job"; width: 100px; clicked => { root.command-invoked("export.remove"); } } Rectangle { horizontal-stretch: 1; } }
                    }
                }
            }
        }
        Rectangle { height: root.feedback == "" ? 30px : 48px; background: #242429;
            HorizontalLayout { padding-left: 16px; padding-right: 16px; spacing: 16px; padding-top: 8px; padding-bottom: 8px;
                Text { vertical-alignment: center; text: "●"; color: root.export-can-cancel ? #d9b876 : #8dc9ad; font-size: 9px; }
                Text { text: ContextHelp.text != "" ? ContextHelp.text : root.feedback == "" ? root.project-summary : root.feedback; color: root.feedback == "" ? #92929f : #d0c6ef; font-size: 11px; wrap: word-wrap; vertical-alignment: center; horizontal-stretch: 1; }
                Action { visible: root.feedback != ""; label: "Dismiss"; width: 68px; height: 25px; clicked => { root.feedback = ""; } }
                Text { text: "PRISM STUDIO"; color: #686878; font-size: 9px; font-weight: 600; vertical-alignment: center; }
            }
        }
    }
    }
    palette-layer := Rectangle {
        visible: root.palette-open;
        x: 0px; y: 0px; width: parent.width; height: parent.height; background: #09090dbb;
        TouchArea { clicked => { root.palette-open = false; keyboard.focus(); } }
        FocusScope {
            x: 0px; y: 0px; width: parent.width; height: parent.height;
            key-pressed(event) => {
                if event.text == Key.Escape { root.palette-open = false; keyboard.focus(); return accept; }
                if event.text == Key.Tab { palette-search.focus(); return accept; }
                return reject;
            }
            Rectangle { x: (parent.width - 620px) / 2; y: 82px; width: 620px; height: Math.min(root.height - 130px, Math.min(510px, Math.max(320px, root.command-items.length * 52px + 150px))); background: #23212a; border-width: 1px; border-color: #665779; border-radius: 9px;
                TouchArea { } // Keep clicks inside the dialog from reaching its backdrop.
                VerticalLayout { padding: 18px; spacing: 12px;
                    HorizontalLayout { height: 25px; Text { text: "PRISM / COMMANDS"; color: #c4b2e0; font-size: 11px; font-weight: 600; vertical-alignment: center; } Rectangle { horizontal-stretch: 1; } Action { label: "Esc"; width: 40px; height: 25px; quiet: true; clicked => { root.palette-open = false; keyboard.focus(); } } }
                    palette-search := Field { height: 38px; text <=> root.palette-query; placeholder-text: "Find an action, panel, or editing tool…"; edited => { root.palette-index = 0; root.palette-filter(); palette-results.content-y = 0px; } navigate(delta) => { root.palette-index = Math.max(0, Math.min(root.command-items.length - 1, root.palette-index + delta)); palette-results.content-y = -Math.max(0px, root.palette-index * 52px - palette-results.height + 52px); } accepted => { if root.command-items.length > 0 { root.palette-run(root.command-items[root.palette-index].id); if !root.palette-open { keyboard.focus(); } } } }
                    palette-results := ScrollView { VerticalLayout { spacing: 3px;
                        if root.command-items.length == 0 : EmptyState { height: 160px; heading: "No matching actions"; detail: "Try a tool name, a panel, or an editing action."; }
                        for item[index] in root.command-items : Rectangle { height: 49px; background: root.palette-index == index ? #3b304c : #28252f; border-radius: 4px;
                            Text { x: 12px; y: 8px; width: parent.width - 140px; text: item.label; color: item.enabled ? #e2d7ee : #797080; font-size: 12px; overflow: elide; }
                            Text { x: 12px; y: 29px; width: parent.width - 110px; text: item.detail; color: #8d809a; font-size: 9px; overflow: elide; }
                            Text { x: parent.width - 110px; y: 15px; width: 98px; text: item.shortcut; color: #b6a1cb; font-size: 10px; horizontal-alignment: right; }
                            TouchArea { enabled: item.enabled; clicked => { root.palette-run(item.id); if !root.palette-open { keyboard.focus(); } } }
                        }
                    } }
                    Text { text: "↑ ↓  Choose an action     Return  Run     Esc  Close"; color: #86778f; font-size: 10px; height: 18px; }
                }
            }
        }
    }

}
